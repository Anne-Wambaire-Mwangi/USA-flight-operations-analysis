                <component
                  refId="Package\Fact\Fact_US_Flights\OLE DB Source"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="OLE DB Source"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
       r.Reporting_Airline_ID
      ,o.Airport_ID as 'Origin_ID'
      ,d.Airport_ID as 'Destination_ID'
      ,c.Cancellation_ID
      ,FL_DATE AS Flight_Date
      ,t.Time_ID as 'Arrival_Time_ID'
      ,DT.Time_ID as 'Departure_Time_ID'
      ,ARR_TIME AS Arr_Time
      ,DEP_TIME AS Dep_Time
      ,DEP_DELAY AS Dep_Delay
      ,ARR_DELAY AS Arr_Delay
      ,ARR_DELAY_NEW AS Arr_Delay_New
      ,CANCELLED AS Cancelled
      ,AIR_TIME AS Air_Time
      ,FLIGHTS AS Flight_Count
      ,DISTANCE AS Distance
      ,CARRIER_DELAY AS Carrier_Delay
      ,WEATHER_DELAY AS Weather_Delay
      ,NAS_DELAY AS Nas_Delay
      ,SECURITY_DELAY AS Security_Delay
      ,LATE_AIRCRAFT_DELAY AS Late_Aircraft_Delay
  FROM [US_Flights].[stg].[US_Flights] as f
  left outer join lup.Reporting_Airline_Code as r
  on r.Reporting_Airline_Code = f.[OP_UNIQUE_CARRIER]
  left outer join [lup].[Airport_ID] as o 
  on o.IATA_Code = f.ORIGIN
  left outer join lup.Airport_ID as d
  on d.IATA_Code = f.DEST
  left outer join lup.Cancellation_Code_ID as c
  on c.Cancel_code = case f.cancellation_code
           when  ' ' then 'N/A'
           when 'A'  then 'A'
           when 'B'  then 'B'
           when 'C'  then 'C'
           when 'D'  then 'D'
           else 'new code available' 
           end
     
   left outer join dim.Time as t
   on t.Hour = CAST(Arr_Time / 100 AS INT)
      left outer join dim.Time as DT
   on Dt.Hour = CAST(Dep_Time / 100 AS INT)</property>
