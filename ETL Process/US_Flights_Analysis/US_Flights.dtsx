                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select  r.Reporting_Airline_ID
       ,OP_UNIQUE_CARRIER as 'Airline_Code'
       ,ra.Description as 'Airline_Name'
from stg.US_Flights as f
left outer join lup.Reporting_Airline_Code as r
on r.Reporting_Airline_Code = f.OP_UNIQUE_CARRIER
left outer join lup.Reporting_Airline as ra
on ra.Code = f.OP_UNIQUE_CARRIER
where f.OP_UNIQUE_CARRIER not in (select Airline_Code from dim.Airline)
group by OP_UNIQUE_CARRIER
       ,r.Reporting_Airline_ID
       ,ra.Description 
order by Reporting_Airline_ID asc</property>
