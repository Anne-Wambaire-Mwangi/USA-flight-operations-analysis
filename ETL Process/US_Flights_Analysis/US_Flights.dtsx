                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select c.Cancellation_ID
     
      ,coalesce(cc.description,'Unknown') as 'Cancellation_Reason'
      ,case cancellation_code
           when  ' ' then 'N/A'
           when 'A'  then 'A'
           when 'B'  then 'B'
           when 'C'  then 'C'
           when 'D'  then 'D'
           else 'new code available' 
           end as 'Cancel_Code'
from stg.US_Flights as f
left outer join lup.Cancellation_Code_ID as c
on c.Cancel_code = case f.cancellation_code
           when  ' ' then 'N/A'
           when 'A'  then 'A'
           when 'B'  then 'B'
           when 'C'  then 'C'
           when 'D'  then 'D'
           else 'new code available' 
           end
left outer join lup.Cancellation_Code as cc
on cc.Code = c.Cancel_code
where case cancellation_code
           when  ' ' then 'N/A'
           when 'A'  then 'A'
           when 'B'  then 'B'
           when 'C'  then 'C'
           when 'D'  then 'D'
           else 'new code available' 
           end not in (select cancel_code from dim.Cancellation)
group by  c.Cancellation_ID
       ,coalesce(cc.description,'Unknown') 
      ,case cancellation_code
           when  ' ' then 'N/A'
           when 'A'  then 'A'
           when 'B'  then 'B'
           when 'C'  then 'C'
           when 'D'  then 'D'
           else 'new code available' 
           end</property>
