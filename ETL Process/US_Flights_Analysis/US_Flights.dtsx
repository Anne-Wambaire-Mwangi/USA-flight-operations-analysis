                <component
                  refId="Package\Dims\dim Airport\OLE DB Source"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="OLE DB Source"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">with AirportCTE( Airport_Key
               ,Airport_IATA_Code
               ,Airport_City
               ,Airport_State_Abr
               ,Airport_State) as (



SELECT  
     
       [ORIGIN_AIRPORT_ID] 
      ,[ORIGIN]
      ,[ORIGIN_CITY_NAME]
      ,[ORIGIN_STATE_ABR]
      ,[ORIGIN_STATE_NM]
      
  FROM [US_Flights].[stg].[US_Flights] as f

union 

SELECT 
       [DEST_AIRPORT_ID]
      ,[DEST]
      ,[DEST_CITY_NAME]
      ,[DEST_STATE_ABR]
      ,[DEST_STATE_NM]
      
  FROM [US_Flights].[stg].[US_Flights] as f)

  select ad.Airport_ID
         ,ac.Airport_IATA_Code
         ,ac.Airport_Key
         ,LTRIM(SUBSTRING(Description,
                CHARINDEX(':', Description) + 1,
                LEN(Description))) as 'Airport_Name'
         ,coalesce(g.airport_country, 'United States') as 'Airport_Country'
         ,ac.Airport_State
         ,ac.Airport_State_Abr
         ,ac.Airport_City
         ,g.Airport_Latitude
         ,g.Airport_Longitude
         ,g.Airport_Altitude
  from AirportCTE as ac
  left outer join lup.Airport_Name  as a
  on a.Code = ac.Airport_IATA_Code
  left outer join lup.Airport_ID as ad
  on ad.IATA_Code = a.Code
  left outer join lup.Airport_Geography as g
  on g.IATA_Code = ac.Airport_IATA_Code
  where ac.Airport_IATA_Code not in (select Airport_IATA_Code from dim.Airport)
  group by ad.Airport_ID
         ,ac.Airport_IATA_Code
         ,ac.Airport_Key
         ,LTRIM(SUBSTRING(Description,
                CHARINDEX(':', Description) + 1,
                LEN(Description)))  
         ,coalesce(g.airport_country, 'United States') 
         ,ac.Airport_State
         ,ac.Airport_State_Abr
         ,ac.Airport_City
         ,g.Airport_Latitude
         ,g.Airport_Longitude
         ,g.Airport_Altitude
order by Airport_IATA_Code asc</property>
